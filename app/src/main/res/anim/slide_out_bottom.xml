<?xml version="1.0" encoding="utf-8"?>
<!-- Timed against animacion_ganchillo played at MainActivity.VELOCIDAD_GANCHILLO (values/animaciones.xml) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/tironeo_interpolator"
    android:shareInterpolator="true">
    <translate
        android:startOffset="@integer/retraso_tironeo"
        android:duration="@integer/duracion_tironeo"
        android:fromYDelta="0%"
        android:toYDelta="100%" />
</set>