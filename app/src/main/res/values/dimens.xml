    <dimen name="margen_pantalla">20dp</dimen>
    <!-- How far the white sheet climbs over the pattern header -->
    <dimen name="solape_hoja">24dp</dimen>
    <!-- Space left under the header content so the sheet overlap does not cover it: solape_hoja + 18dp -->
