    <dimen name="alto_barra_navegacion">80dp</dimen>
    <!-- Bottom padding of a tab list so its last item clears the bar and the floating button -->
    <dimen name="espacio_lista_con_boton">168dp</dimen>
    <dimen name="espacio_lista_sin_boton">104dp</dimen>
</resources>
