<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CalculadoraCrochet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_screen</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/img_splash</item>

        <item name="postSplashScreenTheme">@style/Theme.CalculadoraCrochet</item>
    </style>

    <style name="RelojMinaCrochett" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="colorControlActivated">@color/purple_primary</item>
    </style>

    <style name="RoundedSquare">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>