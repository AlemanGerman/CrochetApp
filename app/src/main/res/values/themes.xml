<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CalculadoraCrochet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <!-- Tema personalizado para pintar el reloj interactivo -->
    <style name="RelojMinaCrochett" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Pinta las manecillas, los números seleccionados y los acentos de morado principal -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="colorControlActivated">@color/purple_primary</item>
    </style>

    <style name="RoundedSquare"><item name="cornerFamily">rounded</item><item name="cornerSize">16dp</item></style>
</resources>