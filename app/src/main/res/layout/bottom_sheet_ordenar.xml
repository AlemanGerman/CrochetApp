<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_selector_pildora"
    android:backgroundTint="@color/white"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D0D0D0"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ordenar proyectos por"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/purple_primary"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:paddingHorizontal="24dp">

        <RadioGroup
            android:id="@+id/rgOpcionesOrden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FECHA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_primary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbFechaReciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Más nuevos primero (Por defecto)"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbFechaAntigua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Más viejos primero"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRECIO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_primary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbPrecioMayor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mayor a menor precio"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbPrecioMenor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menor a mayor precio"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOTOS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_primary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbFotoCon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Con foto primero"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbFotoSin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin foto primero"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/purple_primary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbNombreAZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre (A - Z)"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbNombreZA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre (Z - A)"
                android:textColor="@color/gray_text"
                app:buttonTint="@color/purple_primary" />

        </RadioGroup>
    </ScrollView>
</LinearLayout>