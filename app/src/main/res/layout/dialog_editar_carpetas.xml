<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignar a Carpetas"
            android:textSize="22sp"
            android:textColor="@color/purple_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puedes seleccionar más de una:"
            android:textColor="@color/gray_text"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAmigurumi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amigurumi"
            android:textColor="@color/black"
            app:buttonTint="@color/green_mina"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbLlaveros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Llaveros"
            android:textColor="@color/black"
            app:buttonTint="@color/white_mina"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbRamos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ramos"
            android:textColor="@color/black"
            app:buttonTint="@color/green_mina"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbPeluches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peluches"
            android:textColor="@color/black"
            app:buttonTint="@color/purple_mina"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAccesorios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accesorios"
            android:textColor="@color/black"
            app:buttonTint="@color/purple_mina"/>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbExtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extras"
            android:textColor="@color/black"
            app:buttonTint="@color/yellow_mina"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarCarpetas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textColor="@color/purple_primary"
                app:strokeColor="@color/purple_primary"
                app:cornerRadius="28dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarCarpetas"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Guardar"
                android:backgroundTint="@color/purple_primary"
                android:textColor="@color/white"
                app:cornerRadius="28dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>