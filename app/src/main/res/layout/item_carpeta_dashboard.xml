<?xml version="1.0" encoding="utf-8"?>
<!-- A folder of the dashboard filter row; the purple pill that slides behind the selected one is
     IndicadorPildora, the background of the row (DockCarpetasController) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:background="@drawable/ripple_pildora"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="14dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivIconoCarpeta"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Forma.Mina.Circulo" />

    <TextView
        android:id="@+id/tvNombreCarpeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/nunito_bold"
        android:maxLines="1"
        android:textColor="@color/tinta"
        android:textSize="14sp" />
</LinearLayout>
