<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.example.calculadoracrochet.ui.comun.FondoPatronView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:patron="@drawable/encabezado_papelera" />

            <LinearLayout
                android:id="@+id/contenidoEncabezado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margen_pantalla"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/relleno_inferior_encabezado">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolverPapelera"
                        style="@style/Widget.Mina.BotonIcono.Encabezado"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Volver"
                        app:icon="@drawable/ic_flecha_atras" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVaciarPapelera"
                        style="@style/Widget.Mina.Boton.Encabezado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vaciar"
                        app:icon="@drawable/ic_eliminar_definitivo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTituloPapelera"
                    style="@style/Texto.Encabezado.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityHeading="true"
                    android:text="Papelera" />

                <TextView
                    style="@style/Texto.Encabezado.Subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Se conservan hasta que los borres" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/hojaPapelera"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-24dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProyectosPapelera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/margen_pantalla"
                android:paddingTop="18dp"
                android:paddingBottom="120dp"
                tools:listitem="@layout/item_proyecto_papelera" />

            <LinearLayout
                android:id="@+id/llPapeleraVacia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="40dp"
                android:paddingTop="56dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_circulo_lavanda">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_papelera"
                        app:tint="@color/morado" />
                </FrameLayout>

                <TextView
                    style="@style/Texto.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="La papelera está vacía" />

                <TextView
                    style="@style/Texto.Suave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Los proyectos que elimines aparecerán aquí hasta que los restaures o los borres." />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Actions on the selected projects -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAccionesSeleccion"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="8dp"
        app:shapeAppearance="@style/Forma.Mina.Tarjeta">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvConteoSeleccionados"
                style="@style/Texto.Cuerpo.Fuerte"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                tools:text="2 seleccionados" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestaurarSeleccionados"
                style="@style/Widget.Mina.Boton.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restaurar"
                app:icon="@drawable/ic_restaurar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarSeleccionados"
                style="@style/Widget.Mina.Boton.Peligro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="Borrar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
