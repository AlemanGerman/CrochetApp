<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar proyecto" />

        <TextView
            style="@style/Texto.Suave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ponle nombre para encontrarlo después." />

        <!-- Photo: the dashed slot until there is one -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_foto_vacia">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFotoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="Foto del proyecto"
                android:focusable="true"
                android:scaleType="centerInside"
                app:shapeAppearanceOverlay="@style/Forma.Mina.Tarjeta" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeleccionarFoto"
            style="@style/Widget.Mina.Boton.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Añadir foto (opcional)"
            app:icon="@drawable/ic_agregar_foto" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombreGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Nombre del proyecto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Carpetas (opcional)" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgCarpetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarGuardar"
                style="@style/Widget.Mina.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarGuardar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Guardar"
                app:icon="@drawable/ic_check" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
