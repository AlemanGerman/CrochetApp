<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/encabezado_paso" />

    <ScrollView
        android:id="@+id/hojaPaso"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hoja"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Estambres" />

            <TextView
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lo que costó cada madeja y cuántos gramos usaste." />

            <LinearLayout
                android:id="@+id/llContenedorEstambres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnadirEstambre"
                style="@style/Widget.Mina.Boton.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Añadir estambre"
                app:icon="@drawable/ic_agregar" />

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:accessibilityHeading="true"
                android:text="Accesorios" />

            <TextView
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ojos, relleno, alambre… todo lo que no sea estambre." />

            <LinearLayout
                android:id="@+id/llContenedorMaterialesExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnadirMaterial"
                style="@style/Widget.Mina.Boton.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Añadir accesorio"
                app:icon="@drawable/ic_agregar" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_accion_paso" />
</LinearLayout>
