<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="400dp"
        app:cardBackgroundColor="@color/lavanda"
        app:strokeWidth="0dp">

        <com.example.calculadoracrochet.ui.comun.ZoomableImageView
            android:id="@+id/ivFotoZoom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Foto del proyecto" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/Texto.Suave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Pellizca para hacer zoom"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarZoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cerrar" />
</LinearLayout>
