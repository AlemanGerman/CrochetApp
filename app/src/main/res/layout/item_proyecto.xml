<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivImagenProyecto"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/Forma.Mina.Foto" />

        <TextView
            android:id="@+id/tvNombreProyecto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_extrabold"
            android:maxLines="2"
            android:textColor="@color/tinta"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/tvPrecioProyecto"
            app:layout_constraintStart_toEndOf="@id/ivImagenProyecto"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Osito amigurumi" />

        <TextView
            android:id="@+id/tvPrecioProyecto"
            style="@style/Texto.Monto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@id/tvNombreProyecto"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="$675.00" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tinta_suave"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNombreProyecto"
            app:layout_constraintTop_toBottomOf="@id/tvNombreProyecto"
            tools:text="06 nov 2026" />

        <LinearLayout
            android:id="@+id/llContenedorTags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNombreProyecto"
            app:layout_constraintTop_toBottomOf="@id/tvFecha">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgCarpetasProyecto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvSinCarpeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sin carpeta"
                android:textColor="@color/tinta_suave"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarCarpeta"
                style="@style/Widget.Mina.BotonIcono"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="-10dp"
                android:contentDescription="Asignar carpetas"
                app:icon="@drawable/ic_editar_carpeta"
                app:iconSize="20dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
