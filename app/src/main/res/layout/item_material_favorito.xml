<?xml version="1.0" encoding="utf-8"?>
<!-- A saved yarn or accessory: tap to edit it, the trash button removes it -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circulo_lavanda">

            <ImageView
                android:id="@+id/ivIconoFavorito"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_material_detalle"
                app:tint="@color/morado_fuerte" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreFavorito"
                style="@style/Texto.Cuerpo.Fuerte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Sinfonía" />

            <TextView
                android:id="@+id/tvDetalleFavorito"
                style="@style/Texto.Suave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="$100 la madeja de 100 g" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarFavorito"
            style="@style/Widget.Mina.BotonIcono"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Eliminar"
            app:icon="@drawable/ic_eliminar"
            app:iconTint="@color/tinta_suave" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
