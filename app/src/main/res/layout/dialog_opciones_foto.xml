<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opciones de Foto"
            android:textSize="22sp"
            android:textColor="@color/purple_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarFoto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Seleccionar Foto"
            android:textColor="@color/white"
            android:backgroundTint="@color/purple_primary"
            app:icon="@drawable/ic_photo"
            app:iconTint="@color/white"
            app:cornerRadius="28dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarFotoModal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Eliminar Foto"
            android:textColor="#E53935"
            app:strokeColor="#E53935"
            app:icon="@drawable/ic_eliminar"
            app:iconTint="#E53935"
            app:cornerRadius="28dp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarFoto"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Cancelar"
            android:textColor="@color/gray_text"
            app:cornerRadius="28dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>