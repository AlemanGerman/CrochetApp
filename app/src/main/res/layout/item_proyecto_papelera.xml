<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSeleccionPapelera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/purple_primary" />

        <ImageView
            android:id="@+id/ivFotoPapelera"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="centerCrop"
            android:background="#F3E8FF"
            android:layout_marginStart="4dp"
            tools:src="@drawable/ic_sad" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNombrePapelera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Amigurumi Osito"
                android:textColor="@color/gray_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiasRestantes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Se elimina en 24 días"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRestaurarIndividual"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_flecha_arriba"
            app:tint="@color/green_mina"
            android:contentDescription="Restaurar" />

        <ImageButton
            android:id="@+id/btnEliminarIndividual"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_eliminar_definitivo"
            app:tint="#DC2626"
            android:contentDescription="Eliminar definitivo" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>