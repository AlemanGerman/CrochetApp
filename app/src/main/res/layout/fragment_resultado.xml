<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/encabezado_paso" />

    <ScrollView
        android:id="@+id/hojaPaso"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hoja"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- The suggested price, first and big -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bloque_lavanda"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="22dp">

                <TextView
                    style="@style/Texto.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio sugerido" />

                <TextView
                    android:id="@+id/tvPrecioHero"
                    style="@style/Texto.Monto.Grande"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="44sp"
                    tools:text="$675.00" />

                <TextView
                    android:id="@+id/tvInfoPrecio"
                    style="@style/Texto.Suave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/tinta"
                    tools:text="Incluye 30% de ganancia · +$1.80 de redondeo" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCambiarFecha"
                style="@style/Widget.Mina.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Cambiar la fecha"
                android:visibility="gone"
                app:icon="@drawable/ic_calendario" />

            <!-- The printed receipt: tap MATERIALES or MANO DE OBRA to unfold their detail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="18dp"
                app:cardElevation="3dp"
                app:shapeAppearance="@style/Forma.Mina.Pequena"
                app:strokeWidth="0dp"
                style="@style/Widget.Material3.CardView.Elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/img_papel_arrugado"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/Texto.Ticket.Fuerte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="M I N A   C R O C H E T"
                        android:textAlignment="center"
                        android:textSize="19sp" />

                    <TextView
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="COTIZACIÓN DE PROYECTO"
                        android:textAlignment="center" />

                    <TextView
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ORDEN #0001 PARA CAMILITA"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFechaTicket"
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="8dp"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="--------------------------------"
                        android:textAlignment="center" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/Texto.Ticket.Fuerte" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.15" android:text="ID" />
                        <TextView style="@style/Texto.Ticket.Fuerte" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="CONCEPTO" />
                        <TextView style="@style/Texto.Ticket.Fuerte" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.25" android:gravity="end" android:text="MONTO" />
                    </LinearLayout>

                    <TextView
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="--------------------------------"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:id="@+id/llFilaMateriales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal"
                        android:background="@drawable/ripple_fila"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="32dp"
                        android:gravity="center_vertical">
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.15" android:text="01" />
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="MATERIALES ▼" />
                        <TextView style="@style/Texto.Ticket" android:id="@+id/tvDesgloseMaterial" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.25" android:gravity="end" android:text="$0.00" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetalleMaterialesDesc"
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="40dp"
                        android:textColor="@color/tinta_suave"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.15" android:text="02" />
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="PATRÓN" />
                        <TextView style="@style/Texto.Ticket" android:id="@+id/tvDesglosePatron" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.25" android:gravity="end" android:text="$0.00" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llFilaManoObra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal"
                        android:background="@drawable/ripple_fila"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="32dp"
                        android:gravity="center_vertical">
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.15" android:text="03" />
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="MANO DE OBRA ▼" />
                        <TextView style="@style/Texto.Ticket" android:id="@+id/tvDesgloseManoObra" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.25" android:gravity="end" android:text="$0.00" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetalleManoObraDesc"
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="40dp"
                        android:textColor="@color/tinta_suave"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.15" android:text="04" />
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="EMPAQUE" />
                        <TextView style="@style/Texto.Ticket" android:id="@+id/tvDesgloseEmpaque" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.25" android:gravity="end" android:text="$0.00" />
                    </LinearLayout>

                    <TextView
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="8dp"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="--------------------------------"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SUBTOTAL COSTO:" />
                        <TextView android:id="@+id/tvDesgloseSubtotal" style="@style/Texto.Ticket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/tvLabelGanancia" style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GANANCIA EXTRA:" />
                        <TextView android:id="@+id/tvDesgloseGanancia" style="@style/Texto.Ticket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llFilaRedondeo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView style="@style/Texto.Ticket" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="REDONDEO (+):" />
                        <TextView android:id="@+id/tvDesgloseRedondeo" style="@style/Texto.Ticket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" />
                    </LinearLayout>

                    <TextView
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="12dp"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="================================"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView style="@style/Texto.Ticket.Fuerte" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TOTAL:" android:textSize="19sp" />

                        <TextView
                            android:id="@+id/tvPrecioFinal"
                            style="@style/Texto.Ticket.Fuerte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <TextView style="@style/Texto.Ticket" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CLIENTE: QUIÉN SABE" />
                    <TextView style="@style/Texto.Ticket" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MÉTODO: CON MUCHO ESFUERZO" />
                    <TextView style="@style/Texto.Ticket" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="22dp" android:text="VALOR: INVALUABLE" />

                    <TextView
                        style="@style/Texto.Ticket.Fuerte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="¡Haz que tu tiempo valga!"
                        android:textAlignment="center" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginHorizontal="40dp"
                        android:layout_marginBottom="8dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/codigo_barras" />

                    <TextView
                        style="@style/Texto.Ticket"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="www.instagram.com/mina_crochett/"
                        android:textAlignment="center"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_accion_paso" />
</LinearLayout>
