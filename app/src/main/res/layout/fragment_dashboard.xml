<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTituloDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/purple_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvTituloDashboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tus Proyectos\nGuardados"
                        android:textSize="28sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnConfiguracion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_settings"
                        app:backgroundTint="@color/white"
                        app:tint="@color/purple_primary"
                        app:elevation="2dp"
                        app:fabSize="mini"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardControlesBuscador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/purple_light"
                app:strokeWidth="1dp"
                android:backgroundTint="@color/white"
                app:layout_constraintTop_toBottomOf="@id/cardTituloDashboard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/llControlesBuscador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:hint="Buscar proyecto..."
                        android:textColorHint="@color/gray_text"
                        app:hintTextColor="@color/purple_primary"
                        app:boxStrokeColor="@color/purple_primary"
                        app:startIconDrawable="@drawable/ic_search"
                        app:startIconTint="@color/purple_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarProyecto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gray_text"
                            android:textColorHint="@color/gray_hint"
                            android:inputType="textNoSuggestions"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrdenarFechas"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:icon="@drawable/ic_flecha_abajo"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/purple_primary"
                        app:iconTint="@color/purple_primary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProyectos"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/cardControlesBuscador"
                app:layout_constraintBottom_toTopOf="@id/btnNuevoProyecto"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_proyecto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevoProyecto"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Nuevo Proyecto"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="32dp"
                android:backgroundTint="@color/purple_primary"
                android:elevation="8dp"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>