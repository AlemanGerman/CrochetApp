<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header with the daisy pattern -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.example.calculadoracrochet.ui.comun.FondoPatronView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:patron="@drawable/encabezado_dashboard" />

            <LinearLayout
                android:id="@+id/contenidoEncabezado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margen_pantalla"
                android:paddingTop="10dp"
                android:paddingBottom="@dimen/relleno_inferior_encabezado">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <include
                        layout="@layout/fila_marca"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPapelera"
                        style="@style/Widget.Mina.BotonIcono.Encabezado"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Papelera"
                        app:icon="@drawable/ic_papelera" />
                </LinearLayout>

                <TextView
                    style="@style/Texto.Encabezado.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:accessibilityHeading="true"
                    android:text="Tus proyectos" />

                <TextView
                    android:id="@+id/tvResumenProyectos"
                    style="@style/Texto.Encabezado.Subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Cargando proyectos…" />
            </LinearLayout>
        </FrameLayout>

        <!-- White sheet over the header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-24dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llControlesBuscador"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="@dimen/margen_pantalla"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_buscador"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/tinta_suave" />

                <EditText
                    android:id="@+id/etBuscarProyecto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/nunito_semibold"
                    android:hint="Buscar proyecto"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/tinta"
                    android:textColorHint="@color/tinta_suave"
                    android:textSize="15sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@color/lavanda_borde" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDireccionOrden"
                    style="@style/Widget.Mina.BotonIcono"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Invertir el orden"
                    app:icon="@drawable/ic_flecha_abajo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTipoOrden"
                    style="@style/Widget.Mina.BotonIcono"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Ordenar por"
                    app:icon="@drawable/ic_ordenar" />
            </LinearLayout>

            <!-- Folder filter: the purple pill slides behind the selected folder -->
            <FrameLayout
                android:id="@+id/dockCarpetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <HorizontalScrollView
                    android:id="@+id/hsvCarpetas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="14dp"
                    android:scrollbars="none">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <View
                            android:id="@+id/indicadorSelector"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="@drawable/bg_selector_pildora"
                            android:visibility="invisible" />

                        <LinearLayout
                            android:id="@+id/llCarpetasDashboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </FrameLayout>
                </HorizontalScrollView>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProyectos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/margen_pantalla"
                    android:paddingTop="4dp"
                    android:paddingBottom="@dimen/espacio_lista_con_boton"
                    tools:listitem="@layout/item_proyecto" />

                <!-- No projects yet, or none match the search/folder -->
                <LinearLayout
                    android:id="@+id/llEstadoVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="40dp"
                    android:paddingTop="40dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_circulo_lavanda">

                        <ImageView
                            android:id="@+id/ivEstadoVacio"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/img_todos" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTituloVacio"
                        style="@style/Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Aún no tienes proyectos" />

                    <TextView
                        android:id="@+id/tvMensajeVacio"
                        style="@style/Texto.Suave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Toca «Nuevo proyecto» para hacer tu primera cotización." />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnNuevoProyecto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:text="Nuevo proyecto"
        app:icon="@drawable/ic_agregar" />

</FrameLayout>
