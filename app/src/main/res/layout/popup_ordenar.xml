<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:text="Ordenar por" />

        <LinearLayout
            android:id="@+id/opcCriterioFecha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/ripple_fila"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvCriterioFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_semibold"
                android:text="Fecha de creación"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/checkCriterioFecha"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/morado_fuerte" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcCriterioPrecio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/ripple_fila"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvCriterioPrecio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_semibold"
                android:text="Precio total"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/checkCriterioPrecio"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/morado_fuerte" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcCriterioFoto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/ripple_fila"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvCriterioFoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_semibold"
                android:text="Con foto primero"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/checkCriterioFoto"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/morado_fuerte" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcCriterioNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/ripple_fila"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvCriterioNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_semibold"
                android:text="Nombre del proyecto"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/checkCriterioNombre"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/morado_fuerte" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
