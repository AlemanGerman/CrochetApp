<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeWidth="1dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ordenar por…"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/purple_primary"
            android:letterSpacing="0.08"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:id="@+id/opcCriterioFecha"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvCriterioFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fecha de creación"
                android:textSize="13.5sp"
                android:textColor="@color/gray_text" />

            <ImageView
                android:id="@+id/checkCriterioFecha"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_clean"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcCriterioPrecio"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvCriterioPrecio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Precio total"
                android:textSize="13.5sp"
                android:textColor="@color/gray_text" />

            <ImageView
                android:id="@+id/checkCriterioPrecio"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_clean"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcCriterioFoto"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvCriterioFoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Foto"
                android:textSize="13.5sp"
                android:textColor="@color/gray_text" />

            <ImageView
                android:id="@+id/checkCriterioFoto"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_clean"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/opcCriterioNombre"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvCriterioNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre del proyecto"
                android:textSize="13.5sp"
                android:textColor="@color/gray_text" />

            <ImageView
                android:id="@+id/checkCriterioNombre"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_clean"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>