<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.example.calculadoracrochet.ui.comun.FondoPatronView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:patron="@drawable/encabezado_dashboard" />

        <LinearLayout
            android:id="@+id/contenidoEncabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingTop="10dp"
            android:paddingBottom="@dimen/relleno_inferior_encabezado">

            <include layout="@layout/fila_marca" />

            <TextView
                style="@style/Texto.Encabezado.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:accessibilityHeading="true"
                android:text="Ajustes" />

            <TextView
                style="@style/Texto.Encabezado.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Personaliza tu grandiosa app" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/hojaAjustes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hoja"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/espacio_lista_sin_boton"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingTop="4dp">

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="26dp"
                android:accessibilityHeading="true"
                android:text="Precios" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_circulo_lavanda"
                                android:backgroundTint="@color/lavanda">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_dinero"
                                    app:tint="@color/morado_fuerte" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Texto.Cuerpo.Fuerte"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Redondeo de precios" />

                                <TextView
                                    android:id="@+id/tvEstadoRedondeo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_semibold"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchRedondeo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Redondeo de precios" />
                        </LinearLayout>
                        <!-- Only while rounding is on: the step and an example -->
                        <LinearLayout
                            android:id="@+id/llContenedorMultiplo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Etiqueta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Redondear de" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/cgMultiplos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                app:chipSpacingHorizontal="8dp"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipMultiplo1"
                                    style="@style/Widget.Mina.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$1"
                                    app:checkedIconVisible="false" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipMultiplo5"
                                    style="@style/Widget.Mina.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$5"
                                    app:checkedIconVisible="false" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipMultiplo10"
                                    style="@style/Widget.Mina.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$10"
                                    app:checkedIconVisible="false" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipMultiplo50"
                                    style="@style/Widget.Mina.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$50"
                                    app:checkedIconVisible="false" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipMultiploOtro"
                                    style="@style/Widget.Mina.Chip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Otro"
                                    app:checkedIconVisible="false" />
                            </com.google.android.material.chip.ChipGroup>

                            <!-- Any other amount, only after picking «Otro» -->
                            <LinearLayout
                                android:id="@+id/llMultiploOtro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilMultiploPersonalizado"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="Cantidad"
                                    app:prefixText="$">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etMultiploPersonalizado"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:imeOptions="actionDone"
                                        android:inputType="numberDecimal"
                                        android:maxLines="1" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAplicarMultiplo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="Usar" />
                            </LinearLayout>

                            <!-- Example: exact price → rounded price -->
                            <LinearLayout
                                android:id="@+id/cardSimulacionRedondeo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:background="@drawable/bg_bloque_lavanda"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="12dp">

                                <TextView
                                    style="@style/Texto.Etiqueta"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ejemplo" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvSimulacionBase"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/nunito_bold"
                                        android:textColor="@color/tinta_suave"
                                        android:textSize="18sp"
                                        tools:text="$143.20" />

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_marginHorizontal="10dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_chevron_derecha"
                                        app:tint="@color/morado_fuerte" />

                                    <TextView
                                        android:id="@+id/tvSimulacionResultado"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/nunito_extrabold"
                                        android:textColor="@color/morado_fuerte"
                                        android:textSize="22sp"
                                        tools:text="$145.00" />

                                    <TextView
                                        android:id="@+id/tvSimulacionAjuste"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/nunito_semibold"
                                        android:gravity="end"
                                        android:textColor="@color/tinta_suave"
                                        android:textSize="13sp"
                                        tools:text="+$1.80" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="26dp"
                android:accessibilityHeading="true"
                android:text="Experiencia" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_circulo_lavanda"
                                android:backgroundTint="@color/lavanda">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_vibracion"
                                    app:tint="@color/morado_fuerte" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Texto.Cuerpo.Fuerte"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Vibración" />

                                <TextView
                                    android:id="@+id/tvEstadoVibracion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_semibold"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchVibracion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Vibración" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_circulo_lavanda"
                                android:backgroundTint="@color/lavanda">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_photo"
                                    app:tint="@color/morado_fuerte" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Texto.Cuerpo.Fuerte"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Color de la foto en las tarjetas" />

                                <TextView
                                    android:id="@+id/tvEstadoColorDinamico"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_semibold"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchColorDinamico"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Color de la foto en las tarjetas" />
                        </LinearLayout>
                        <TextView
                            style="@style/Texto.Suave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="La tarjeta de cada proyecto toma el color de su foto." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="26dp"
                android:accessibilityHeading="true"
                android:text="Tus datos" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/itemAbrirMisMateriales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_lavanda">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_material_detalle"
                            app:tint="@color/morado_fuerte" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Cuerpo.Fuerte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis materiales" />

                        <TextView
                            android:id="@+id/tvConteoMisMateriales"
                            style="@style/Texto.Suave"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estambres y accesorios para añadir con un toque"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_derecha"
                        app:tint="@color/tinta_suave" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/itemAbrirPapelera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circulo_lavanda">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_papelera"
                            app:tint="@color/morado_fuerte" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Cuerpo.Fuerte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Papelera" />

                        <TextView
                            android:id="@+id/tvConteoPapelera"
                            style="@style/Texto.Suave"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Restaura o borra lo que eliminaste"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_derecha"
                        app:tint="@color/tinta_suave" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Mina Crochet · Hecho a mano, hecho con amor 💜"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
