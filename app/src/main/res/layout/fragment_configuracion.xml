<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Barra superior / Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/purple_primary">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <ImageButton
                    android:id="@+id/btnVolverConfiguracion"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_flecha_abajo"
                    android:rotation="90"
                    app:tint="@color/white"
                    android:contentDescription="Regresar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    app:layout_constraintStart_toEndOf="@id/btnVolverConfiguracion"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuración"
                        android:textSize="21sp"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personaliza tu experiencia y cálculos"
                        android:textSize="12sp"
                        android:textColor="#F3E8FF" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="32dp">

                <!-- CARD 1: REDONDEO DE PRECIOS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/purple_light"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Encabezado con Switch -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                android:backgroundTint="#F3E8FF">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_dinero"
                                    app:tint="@color/purple_primary" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Redondeo de precios"
                                    android:textSize="16sp"
                                    android:textColor="@color/gray_text"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvEstadoRedondeo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Activo (redondeo hacia arriba)"
                                    android:textSize="12sp"
                                    android:textColor="@color/purple_primary" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchRedondeo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:useMaterialThemeColors="false"
                                app:thumbTint="@color/purple_primary"
                                app:trackTint="@color/purple_light" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Redondea automáticamente el precio sugerido de venta para evitar dar cambio en centavos o cifras incómodas."
                            android:textSize="12sp"
                            android:textColor="@color/gray_hint" />

                        <!-- Contenedor desplegable de Múltiplo -->
                        <LinearLayout
                            android:id="@+id/llContenedorMultiplo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#F0F0F0"
                                android:layout_marginBottom="14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Múltiplo de redondeo deseado:"
                                android:textSize="14sp"
                                android:textColor="@color/gray_text"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Elige una opción rápida o escribe tu propio múltiplo:"
                                android:textSize="12sp"
                                android:textColor="@color/gray_hint"
                                android:layout_marginBottom="10dp" />

                            <!-- Chips de selección rápida -->
                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="none"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/cgMultiplos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:singleLine="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipMultiplo1"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="$1 (Entero)"
                                        android:textColor="@color/gray_text"
                                        app:chipStrokeColor="@color/purple_light"
                                        app:chipStrokeWidth="1dp" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipMultiplo5"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="$5 (Default)"
                                        android:textColor="@color/gray_text"
                                        app:chipStrokeColor="@color/purple_light"
                                        app:chipStrokeWidth="1dp" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipMultiplo10"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="$10"
                                        android:textColor="@color/gray_text"
                                        app:chipStrokeColor="@color/purple_light"
                                        app:chipStrokeWidth="1dp" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipMultiplo20"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="$20"
                                        android:textColor="@color/gray_text"
                                        app:chipStrokeColor="@color/purple_light"
                                        app:chipStrokeWidth="1dp" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipMultiplo50"
                                        style="@style/Widget.MaterialComponents.Chip.Choice"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="$50"
                                        android:textColor="@color/gray_text"
                                        app:chipStrokeColor="@color/purple_light"
                                        app:chipStrokeWidth="1dp" />
                                </com.google.android.material.chip.ChipGroup>
                            </HorizontalScrollView>

                            <!-- Campo Personalizado -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="14dp">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilMultiploPersonalizado"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="Múltiplo exacto ($)"
                                    app:boxStrokeColor="@color/purple_primary"
                                    app:hintTextColor="@color/purple_primary"
                                    app:startIconDrawable="@drawable/ic_dinero"
                                    app:startIconTint="@color/purple_primary">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etMultiploPersonalizado"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="numberDecimal"
                                        android:maxLines="1"
                                        android:text="5"
                                        android:textColor="@color/gray_text"
                                        android:textSize="15sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAplicarMultiplo"
                                    style="@style/Widget.MaterialComponents.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="56dp"
                                    android:layout_marginStart="8dp"
                                    android:text="Aplicar"
                                    android:backgroundTint="@color/purple_primary"
                                    app:cornerRadius="10dp" />
                            </LinearLayout>

                            <!-- Tarjeta de Simulación en Vivo -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardSimulacionRedondeo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#DDD6FE"
                                app:strokeWidth="1dp"
                                android:backgroundTint="#F5F3FF">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="✨ Vista previa en tiempo real"
                                        android:textSize="12sp"
                                        android:textColor="@color/purple_primary"
                                        android:textStyle="bold"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:id="@+id/tvSimulacionBase"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ejemplo sin redondeo: $143.20"
                                        android:textSize="12sp"
                                        android:textColor="@color/gray_text" />

                                    <TextView
                                        android:id="@+id/tvSimulacionResultado"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Con redondeo: $145.00 (+$1.80 a tu favor)"
                                        android:textSize="13sp"
                                        android:textColor="@color/purple_primary"
                                        android:textStyle="bold"
                                        android:layout_marginTop="2dp" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 2: VIBRACIÓN Y RESPUESTA HÁPTICA -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/purple_light"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- Encabezado con Switch -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                android:backgroundTint="#EDE9FE">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_vibracion"
                                    app:tint="@color/purple_primary" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Vibración y respuesta háptica"
                                    android:textSize="16sp"
                                    android:textColor="@color/gray_text"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvEstadoVibracion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Activada en toda la app"
                                    android:textSize="12sp"
                                    android:textColor="@color/purple_primary" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchVibracion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:useMaterialThemeColors="false"
                                app:thumbTint="@color/purple_primary"
                                app:trackTint="@color/purple_light" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Genera una sutil vibración táctil al tocar botones principales, cambiar opciones, filtrar y guardar tus creaciones."
                            android:textSize="12sp"
                            android:textColor="@color/gray_hint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProbarVibracion"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:text="Probar vibración táctil"
                            android:textColor="@color/purple_primary"
                            app:icon="@drawable/ic_vibracion"
                            app:iconTint="@color/purple_primary"
                            app:strokeColor="@color/purple_primary"
                            app:cornerRadius="10dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 3: ACERCA DE LA APP -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#F0F0F0"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculadora Crochet 🧶"
                            android:textSize="15sp"
                            android:textColor="@color/gray_text"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tus preferencias se guardan automáticamente en tu dispositivo."
                            android:textSize="12sp"
                            android:textColor="@color/gray_hint"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
