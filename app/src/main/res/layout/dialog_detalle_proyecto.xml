<?xml version="1.0" encoding="utf-8"?>
<!-- Detail of a saved project, shown as a bottom sheet (DetalleProyectoDialog) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/contenidoDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margen_pantalla"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalleCerrar"
                style="@style/Widget.Mina.BotonIcono.Tonal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginTop="8dp"
                android:contentDescription="Cerrar"
                app:icon="@drawable/ic_cerrar"
                app:iconSize="20dp" />
        </FrameLayout>

        <!-- Photo: tap to see it large (or to add one), the round button changes it -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvDetalleFotoContenedor"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Foto del proyecto"
            app:cardBackgroundColor="@color/lavanda"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivDetalleFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarFotoDetalle"
                style="@style/Widget.Mina.BotonIcono"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:contentDescription="Cambiar foto"
                app:backgroundTint="@color/white"
                app:icon="@drawable/ic_agregar_foto"
                app:iconSize="20dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Name and date: both editable -->
        <TextView
            android:id="@+id/tvDetalleNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/ripple_fila"
            android:drawablePadding="8dp"
            android:fontFamily="@font/nunito_extrabold"
            android:paddingVertical="2dp"
            android:textColor="@color/tinta"
            android:textSize="24sp"
            app:drawableEndCompat="@drawable/ic_lapiz"
            app:drawableTint="@color/tinta_tenue"
            tools:text="Osito amigurumi" />

        <TextView
            android:id="@+id/tvDetalleFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/ripple_fila"
            android:drawablePadding="6dp"
            android:fontFamily="@font/nunito_semibold"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:textColor="@color/tinta_suave"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_calendario"
            app:drawableTint="@color/tinta_suave"
            tools:text="06 de noviembre, 2026" />

        <!-- Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_bloque_lavanda"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio final" />

            <TextView
                android:id="@+id/tvDetalleTotal"
                style="@style/Texto.Monto.Grande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="34sp"
                tools:text="$675.00" />
        </LinearLayout>

        <!-- Breakdown -->
        <TextView
            style="@style/Texto.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Desglose" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:id="@+id/llToggleMateriales"
                    style="@style/Fila.Desglose"
                    android:contentDescription="Materiales, toca para ver el detalle">

                    <TextView
                        style="@style/Fila.Desglose.Concepto"
                        android:text="Materiales" />

                    <TextView
                        android:id="@+id/tvCostoMaterialesResumen"
                        style="@style/Fila.Desglose.Monto"
                        tools:text="$120.00" />

                    <ImageView
                        android:id="@+id/ivFlechaMateriales"
                        style="@style/Fila.Desglose.Flecha" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDesgloseMateriales"
                    style="@style/Fila.Desglose.Detalle" />

                <LinearLayout
                    android:id="@+id/llToggleManoObra"
                    style="@style/Fila.Desglose"
                    android:contentDescription="Mano de obra, toca para ver el detalle">

                    <TextView
                        style="@style/Fila.Desglose.Concepto"
                        android:text="Mano de obra" />

                    <TextView
                        android:id="@+id/tvCostoManoObraResumen"
                        style="@style/Fila.Desglose.Monto"
                        tools:text="$350.00" />

                    <ImageView
                        android:id="@+id/ivFlechaManoObra"
                        style="@style/Fila.Desglose.Flecha" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDesgloseManoObra"
                    style="@style/Fila.Desglose.Detalle" />

                <LinearLayout style="@style/Fila.Desglose">

                    <TextView
                        style="@style/Fila.Desglose.Concepto"
                        android:text="Patrón" />

                    <TextView
                        android:id="@+id/tvDetallePatron"
                        style="@style/Fila.Desglose.Monto"
                        tools:text="$0.00" />

                    <Space style="@style/Fila.Desglose.Flecha" />
                </LinearLayout>

                <LinearLayout style="@style/Fila.Desglose">

                    <TextView
                        style="@style/Fila.Desglose.Concepto"
                        android:text="Empaque" />

                    <TextView
                        android:id="@+id/tvDetalleEmpaque"
                        style="@style/Fila.Desglose.Monto"
                        tools:text="$25.00" />

                    <Space style="@style/Fila.Desglose.Flecha" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/lavanda_borde" />

                <LinearLayout style="@style/Fila.Desglose">

                    <TextView
                        android:id="@+id/tvEtiquetaGanancia"
                        style="@style/Fila.Desglose.Concepto"
                        android:text="Ganancia extra" />

                    <TextView
                        android:id="@+id/tvDetalleGanancia"
                        style="@style/Fila.Desglose.Monto"
                        android:textColor="@color/verde_texto"
                        tools:text="+$150.00" />

                    <Space style="@style/Fila.Desglose.Flecha" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llFilaRedondeoDetalle"
                    style="@style/Fila.Desglose"
                    android:visibility="gone">

                    <TextView
                        style="@style/Fila.Desglose.Concepto"
                        android:text="Redondeo a tu favor" />

                    <TextView
                        android:id="@+id/tvDetalleRedondeo"
                        style="@style/Fila.Desglose.Monto"
                        android:textColor="@color/verde_texto"
                        tools:text="+$1.80" />

                    <Space style="@style/Fila.Desglose.Flecha" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpcionesDetalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Editar"
                app:icon="@drawable/ic_lapiz" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetalleDuplicar"
                style="@style/Widget.Mina.Boton.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="Duplicar"
                app:icon="@drawable/ic_copiar" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetalleEliminar"
            style="@style/Widget.Mina.Boton.Texto.Peligro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mover a la papelera"
            app:icon="@drawable/ic_eliminar" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
