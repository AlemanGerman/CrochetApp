<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardColorIndicador"
        android:layout_width="10dp"
        android:layout_height="36dp"
        app:cardCornerRadius="5dp"
        app:cardElevation="0dp"
        android:layout_marginEnd="10dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivIconoCarpetaStat"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:background="#F3E8FF"
        app:shapeAppearanceOverlay="@style/RoundedSquare"
        tools:src="@drawable/img_amigurumi"/>

    <TextView
        android:id="@+id/tvNombreCarpetaStat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        tools:text="Amigurumi" />

    <TextView
        android:id="@+id/tvConteoCarpetaStat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/purple_primary"
        tools:text="12 proyectos (43%)" />

</LinearLayout>